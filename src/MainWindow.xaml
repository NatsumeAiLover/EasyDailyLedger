<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="日常账本" Width="1220" Height="850" MinWidth="1020" MinHeight="700" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Background="#F4F6F5" Foreground="#233731" Language="zh-CN">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#233731"/>
    <SolidColorBrush x:Key="Muted" Color="#667970"/>
    <SolidColorBrush x:Key="Accent" Color="#21685C"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#233731"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#21685C"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#21685C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="18,12"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#D5DFD8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#233731"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="#D5DFD8"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#233731"/></Style>
    <Style TargetType="DatePicker"><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectedDateFormat" Value="Short"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="20"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#667970"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F7F9F8"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E9EEEA"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="43"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF2EF"/><Setter Property="Foreground" Value="#52685C"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#E7EEEA" Padding="16,30,16,20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,36"><TextBlock Text="日常账本" FontSize="24" FontWeight="Medium"/><TextBlock Text="把每一天，记清楚。" Foreground="#667970" FontSize="11" Margin="1,8,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0"><TextBlock Text="本机保存 · 无需联网" FontSize="11" Foreground="#667970"/><TextBlock Text="Daily Ledger  1.0" FontSize="11" Foreground="#667970" Margin="0,6,0,0"/></StackPanel>
        <StackPanel><Button x:Name="NavHome" Content="首页概览" Style="{StaticResource Nav}"/><Button x:Name="NavLedger" Content="每日账单" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="设置与备份" Style="{StaticResource Nav}"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="本月概览" FontSize="26" FontWeight="Medium"/><TextBlock x:Name="PageSubtitle" Text="今天的每一笔，都在这里。" Foreground="#667970" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <StackPanel x:Name="MonthToolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PreviousMonth" Content="‹" FontSize="19" Width="35" Padding="0" Height="36" ToolTip="上一个月"/><TextBlock x:Name="MonthLabel" Text="2026 年 11 月" Width="140" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/><Button x:Name="NextMonth" Content="›" FontSize="19" Width="35" Padding="0" Height="36" ToolTip="下一个月"/><Button x:Name="CurrentMonth" Content="本月" Margin="10,0,0,0" Height="36" Padding="12,5"/></StackPanel>
      </Grid>
      <ScrollViewer x:Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
        <StackPanel>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Margin="0,0,10,0"><StackPanel><TextBlock Text="本月已支出"/><TextBlock x:Name="SpentValue" Text="¥0.00" FontSize="30" FontWeight="Medium" Margin="0,12,0,9"/><TextBlock x:Name="CompareValue" Style="{StaticResource Label}" Text="暂无上月同期数据"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Background="#E3F0E9" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="RemainingLabel" Text="预算还剩"/><TextBlock x:Name="RemainingValue" Text="待设置" FontSize="30" FontWeight="Medium" Margin="0,12,0,9"/><TextBlock x:Name="FutureValue" Style="{StaticResource Label}" Text="设置预算后，即可计算每天可用金额"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="本月日均支出"/><TextBlock x:Name="AverageValue" Text="¥0.00" FontSize="30" FontWeight="Medium" Margin="0,12,0,9"/><TextBlock x:Name="AverageHint" Style="{StaticResource Label}"/></StackPanel></Border>
          </Grid>
          <Grid Margin="2,0,2,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="BudgetUsage" Text="尚未设置本月预算" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="MonthElapsed" Foreground="#667970" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel><Button x:Name="SetBudgetHome" Grid.Column="1" Content="设置预算" Padding="10,5" FontSize="12"/></Grid>
          <ProgressBar x:Name="BudgetProgress" Height="6" Maximum="100" Background="#E1E8E3" Foreground="#2E7D69" BorderThickness="0" Margin="2,0,2,22"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="钱花在哪里" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="CategoryBars"/></StackPanel></Border>
              <Border Style="{StaticResource Panel}" Margin="0,0,0,14"><StackPanel><DockPanel><Button x:Name="OpenAllEntries" Content="全部账单 →" DockPanel.Dock="Right" FontSize="12" Padding="8,3" VerticalAlignment="Top"/><TextBlock Text="最近的每日账单" Style="{StaticResource SectionTitle}"/></DockPanel><StackPanel x:Name="RecentDays"/></StackPanel></Border>
              <TextBlock x:Name="IncomeSummary" Foreground="#667970" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,15"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock x:Name="EntryTitle" Text="记一笔" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ExpenseType" Content="支出" Margin="0,0,4,0"/><Button x:Name="IncomeType" Grid.Column="1" Content="收入" Margin="4,0,0,0"/></Grid>
                <TextBlock Text="金额（元）" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="EntryAmount" FontSize="21" MaxLength="12" AutomationProperties.Name="记账金额" Margin="0,0,0,10"/>
                <TextBlock Text="大类" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="EntryCategory" Margin="0,0,0,10" AutomationProperties.Name="记账大类"/>
                <StackPanel x:Name="EntryNotePanel"><TextBlock Text="做了什么 · 选填" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="EntryNote" MaxLength="200" AutomationProperties.Name="记账备注" Margin="0,0,0,10"/></StackPanel>
                <TextBlock Text="日期" FontSize="12" Margin="0,0,0,6"/><DatePicker x:Name="EntryDate" AutomationProperties.Name="记账日期" Margin="0,0,0,14"/>
                <Button x:Name="SaveEntry" Content="保存这笔支出" Style="{StaticResource Primary}" Padding="12,12"/>
                <Button x:Name="CancelEdit" Content="取消修改" Visibility="Collapsed" Margin="0,8,0,0"/>
                <TextBlock x:Name="EntryFeedback" Foreground="#21685C" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="LedgerView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LedgerMonthSummary" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="ExportMonth" Grid.Column="1" Content="导出本月表格" Margin="12,0,0,0"/></Grid></Border>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="FilterType" AutomationProperties.Name="筛选收支类型"/><ComboBox x:Name="FilterCategory" DisplayMemberPath="FilterLabel" Grid.Column="1" Margin="10,0,0,0" AutomationProperties.Name="筛选大类"/><Grid Grid.Column="2" Margin="10,0,0,0"><TextBox x:Name="SearchText" ToolTip="搜索本月备注、大类或日期" AutomationProperties.Name="搜索本月账单"/><TextBlock x:Name="SearchHint" Text="搜索备注、大类或日期" Foreground="#667970" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/></Grid></Grid>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0"><Grid><DataGrid x:Name="EntriesGrid"><DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#EAF0EC" Padding="12,9"><TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#3D5A49"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle><DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" Width="65"/><DataGridTextColumn Header="大类" Binding="{Binding CategoryName}" Width="130"/><DataGridTextColumn Header="金额（元）" Binding="{Binding AmountLabel}" Width="120"/><DataGridTextColumn Header="做了什么" Binding="{Binding Note}" Width="*" MinWidth="150"/></DataGrid.Columns></DataGrid><TextBlock x:Name="LedgerEmpty" Text="这个月还没有账目，去首页记下第一笔吧。" Foreground="#667970" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FilterSummary" VerticalAlignment="Center" FontSize="12" Foreground="#667970"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="EditEntry" Content="修改选中账目"/><Button x:Name="DeleteEntry" Content="删除" Margin="8,0,0,0" Foreground="#A23D32"/></StackPanel></Grid>
      </Grid>
      <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
        <StackPanel>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="本月预算" Style="{StaticResource SectionTitle}"/><DockPanel><Button x:Name="SetBudgetSettings" Content="修改预算" DockPanel.Dock="Right"/><StackPanel><TextBlock x:Name="SettingsBudget" FontSize="21"/><TextBlock Text="收入不自动增加预算；新月份沿用最近一个月的预算，剩余金额不自动累加。" Style="{StaticResource Label}" Margin="0,6,12,0"/></StackPanel></DockPanel></StackPanel></Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="管理大类" Style="{StaticResource SectionTitle}"/><TextBlock Text="重命名会同步更新历史账目。停用的大类仍保留历史记录，也可以重新启用。" Style="{StaticResource Label}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="CategoryKind" AutomationProperties.Name="管理大类类型"/><ComboBox x:Name="ManageCategory" Grid.Column="1" Margin="10,0,0,0" AutomationProperties.Name="管理大类选择"/><Button x:Name="AddCategory" Grid.Column="2" Content="新增" Margin="10,0,0,0"/><Button x:Name="RenameCategory" Grid.Column="3" Content="改名" Margin="7,0,0,0"/><Button x:Name="ToggleCategory" Grid.Column="4" Content="停用 / 启用" Margin="7,0,0,0"/></Grid></StackPanel></Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource SectionTitle}"/><TextBlock Text="每次更改都会保留上一版账本。手动备份包含全部账目、预算和大类，可用于换电脑或恢复数据。" Style="{StaticResource Label}" Margin="0,0,0,14"/><WrapPanel><Button x:Name="ManualBackup" Content="备份全部数据" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button x:Name="RestoreBackup" Content="从备份恢复" Margin="0,0,8,8"/><Button x:Name="OpenBackupFolder" Content="查看自动备份" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="DataLocation" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/><Button x:Name="OpenDataFolder" Content="打开数据文件夹" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="统计口径" Style="{StaticResource SectionTitle}"/><TextBlock Text="预算剩余 = 本月预算 − 本月支出&#10;收支结余 = 本月收入 − 本月支出，不代表银行卡余额&#10;日均支出按从月初到今天的自然天数计算，未消费的日期也计入天数&#10;剩余每天可用按明天至月底计算；历史月份展示整月汇总&#10;当前月份对比上月相同日期范围；历史月份对比上月整月" Foreground="#667970" FontSize="12" LineHeight="25"/><TextBlock Text="个人本机账本 · 版本 1.0.0" Style="{StaticResource Label}" Margin="0,15,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" Grid.Row="2" Text="准备就绪" FontSize="11" Foreground="#667970" Margin="2,12,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
