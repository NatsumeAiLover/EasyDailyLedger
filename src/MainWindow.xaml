<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Title="日常账本 1.2" Width="1220" Height="850" MinWidth="1020" MinHeight="700" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" Language="zh-CN">
