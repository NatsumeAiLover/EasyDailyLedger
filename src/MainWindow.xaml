      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌄" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Margin="10,6,30,6" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="p:DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="9,6"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DatePicker">
      <Setter Property="MinHeight" Value="36"/><Setter Property="SelectedDateFormat" Value="Short"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CalendarStyle" Value="{DynamicResource CalendarTheme}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker"><Grid x:Name="PART_Root"><Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><p:DatePickerTextBox x:Name="PART_TextBox" Foreground="{TemplateBinding Foreground}"/><Button x:Name="PART_Button" Grid.Column="1" Content="▦" Padding="0" Margin="2" FontSize="17" Focusable="False" ToolTip="选择日期"/></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CalendarDay" TargetType="p:CalendarDayButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinWidth" Value="34"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarDayButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Trigger><Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CalendarPeriod" TargetType="p:CalendarButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinWidth" Value="58"/><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarButton"><Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="HasSelectedDays" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CalendarLayout" TargetType="p:CalendarItem">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarItem">
        <ControlTemplate.Resources><DataTemplate x:Key="{x:Static p:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8"/></DataTemplate></ControlTemplate.Resources>
        <Border x:Name="PART_Root" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button x:Name="PART_PreviousButton" Content="‹" Padding="0,4"/><Button x:Name="PART_HeaderButton" Grid.Column="1" Padding="8,4" Background="Transparent"/><Button x:Name="PART_NextButton" Grid.Column="2" Content="›" Padding="0,4"/></Grid><Grid x:Name="PART_MonthView" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid><Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions></Grid></Grid></Border>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding DisplayMode,RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
          <DataTrigger Binding="{Binding DisplayMode,RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CalendarTheme" TargetType="Calendar">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDay}"/><Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarPeriod}"/><Setter Property="CalendarItemStyle" Value="{StaticResource CalendarLayout}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><StackPanel x:Name="PART_Root"><p:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></StackPanel></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton IsChecked="{Binding IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="Chevron" Text="›" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><ContentPresenter Grid.Column="1"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}"/></ToggleButton><ContentPresenter x:Name="ExpandedContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="10,7"/></Style>
    <Style TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Border}" CornerRadius="4" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="{DynamicResource AppBackground}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="20"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateRow}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="43"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource HeaderInk}"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBackground}" Padding="16,30,16,20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,36"><TextBlock Text="日常账本" FontSize="24" FontWeight="Medium"/><TextBlock Text="把每一天，记清楚。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="1,8,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0"><Button x:Name="ToggleTheme" Content="切换黑灰" Padding="10,9" FontSize="12" HorizontalContentAlignment="Center" Margin="0,0,0,16" ToolTip="依次切换浅色、黑灰深色、墨绿深色，并记住选择"/><TextBlock Text="本机保存 · 无需联网" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock Text="Daily Ledger  1.2" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
        <StackPanel><Button x:Name="NavHome" Content="首页概览" Style="{StaticResource Nav}"/><Button x:Name="NavLedger" Content="每日账单" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="设置与备份" Style="{StaticResource Nav}"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="本月概览" FontSize="26" FontWeight="Medium"/><TextBlock x:Name="PageSubtitle" Text="今天的每一笔，都在这里。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <StackPanel x:Name="MonthToolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PreviousMonth" Content="‹" FontSize="19" Width="35" Padding="0" Height="36" ToolTip="上一个月"/><TextBlock x:Name="MonthLabel" Text="2026 年 11 月" Width="140" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/><Button x:Name="NextMonth" Content="›" FontSize="19" Width="35" Padding="0" Height="36" ToolTip="下一个月"/><Button x:Name="CurrentMonth" Content="本月" Margin="10,0,0,0" Height="36" Padding="12,5"/></StackPanel>
      </Grid>
      <ScrollViewer x:Name="HomeView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
        <StackPanel>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Margin="0,0,10,0"><StackPanel><TextBlock Text="本月已支出"/><TextBlock x:Name="SpentValue" Text="¥0.00" FontSize="30" FontWeight="Medium" Margin="0,12,0,9"/><TextBlock x:Name="CompareValue" Style="{StaticResource Label}" Text="暂无上月同期数据"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Background="{DynamicResource BudgetSurface}" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="RemainingLabel" Text="预算还剩"/><TextBlock x:Name="RemainingValue" Text="待设置" FontSize="30" FontWeight="Medium" Margin="0,12,0,9"/><TextBlock x:Name="FutureValue" Style="{StaticResource Label}" Text="设置预算后，即可计算每天可用金额"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="本月日均支出"/><TextBlock x:Name="AverageValue" Text="¥0.00" FontSize="30" FontWeight="Medium" Margin="0,12,0,9"/><TextBlock x:Name="AverageHint" Style="{StaticResource Label}"/></StackPanel></Border>
          </Grid>
          <Grid Margin="2,0,2,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="BudgetUsage" Text="尚未设置本月预算" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="MonthElapsed" Foreground="{DynamicResource Muted}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/></StackPanel><Button x:Name="SetBudgetHome" Grid.Column="1" Content="设置预算" Padding="10,5" FontSize="12"/></Grid>
          <ProgressBar x:Name="BudgetProgress" Height="6" Maximum="100" Background="{DynamicResource ProgressTrack}" Foreground="{DynamicResource Accent}" BorderThickness="0" Margin="2,0,2,22"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
              <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="钱花在哪里" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="CategoryBars"/></StackPanel></Border>
              <Border Style="{StaticResource Panel}" Margin="0,0,0,14"><StackPanel><DockPanel><Button x:Name="OpenAllEntries" Content="全部账单 →" DockPanel.Dock="Right" FontSize="12" Padding="8,3" VerticalAlignment="Top"/><TextBlock Text="最近的每日账单" Style="{StaticResource SectionTitle}"/></DockPanel><StackPanel x:Name="RecentDays"/></StackPanel></Border>
              <TextBlock x:Name="IncomeSummary" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,15"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Panel}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock x:Name="EntryTitle" Text="记一笔" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ExpenseType" Content="支出" Margin="0,0,4,0"/><Button x:Name="IncomeType" Grid.Column="1" Content="收入" Margin="4,0,0,0"/></Grid>
                <TextBlock Text="金额（元）" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="EntryAmount" FontSize="21" MaxLength="12" AutomationProperties.Name="记账金额" Margin="0,0,0,10"/>
                <TextBlock Text="大类" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="EntryCategory" Margin="0,0,0,10" AutomationProperties.Name="记账大类"/>
                <StackPanel x:Name="EntryNotePanel"><TextBlock Text="做了什么 · 选填" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="EntryNote" MaxLength="200" AutomationProperties.Name="记账备注" Margin="0,0,0,10"/></StackPanel>
                <TextBlock Text="日期" FontSize="12" Margin="0,0,0,6"/><DatePicker x:Name="EntryDate" AutomationProperties.Name="记账日期" Margin="0,0,0,14"/>
                <Button x:Name="SaveEntry" Content="保存这笔支出" Style="{StaticResource Primary}" Padding="12,12"/>
                <Button x:Name="CancelEdit" Content="取消修改" Visibility="Collapsed" Margin="0,8,0,0"/>
                <TextBlock x:Name="EntryFeedback" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="LedgerView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LedgerMonthSummary" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="ExportMonth" Grid.Column="1" Content="导出本月表格" Margin="12,0,0,0"/></Grid></Border>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="FilterType" AutomationProperties.Name="筛选收支类型"/><ComboBox x:Name="FilterCategory" DisplayMemberPath="FilterLabel" Grid.Column="1" Margin="10,0,0,0" AutomationProperties.Name="筛选大类"/><Grid Grid.Column="2" Margin="10,0,0,0"><TextBox x:Name="SearchText" ToolTip="搜索本月备注、大类或日期" AutomationProperties.Name="搜索本月账单"/><TextBlock x:Name="SearchHint" Text="搜索备注、大类或日期" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/></Grid><Button x:Name="DateSort" Grid.Column="3" Content="日期 ↓ 近到远" Margin="10,0,0,0" FontSize="12" ToolTip="点击日期切换从近到远或从远到近" AutomationProperties.Name="日期排序"/></Grid>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0"><Grid>
          <DataGrid x:Name="EntriesGrid" CanUserSortColumns="False" VirtualizingPanel.IsVirtualizingWhenGrouping="False">
            <DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem">
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
                <Expander IsExpanded="{Binding Name.IsExpanded,Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                  <Expander.Header><Border Background="{DynamicResource GroupBackground}" Padding="10,11" HorizontalAlignment="Stretch"><DockPanel LastChildFill="True">
                    <TextBlock Text="{Binding Name.DateLabel}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource HeaderInk}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name.Summary}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </DockPanel></Border></Expander.Header>
                  <ItemsPresenter/>
                </Expander>
              </ControlTemplate></Setter.Value></Setter>
            </Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle>
            <DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding KindLabel}" Width="65"/><DataGridTextColumn Header="大类" Binding="{Binding CategoryName}" Width="130"/><DataGridTextColumn Header="金额（元）" Binding="{Binding AmountLabel}" Width="120"/><DataGridTextColumn Header="做了什么" Binding="{Binding Note}" Width="*" MinWidth="150"/></DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="LedgerEmpty" Text="这个月还没有账目，去首页记下第一笔吧。" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid></Border>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FilterSummary" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="EditEntry" Content="修改选中账目"/><Button x:Name="DeleteEntry" Content="删除" Margin="8,0,0,0" Foreground="{DynamicResource Danger}"/></StackPanel></Grid>
      </Grid>
      <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
        <StackPanel>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><TextBlock Text="浅色、黑灰深色、墨绿深色；重开后保持上次选择。" Style="{StaticResource Label}"/></StackPanel><ComboBox x:Name="ThemeMode" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="外观模式"/></Grid></Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="本月预算" Style="{StaticResource SectionTitle}"/><DockPanel><Button x:Name="SetBudgetSettings" Content="修改预算" DockPanel.Dock="Right"/><StackPanel><TextBlock x:Name="SettingsBudget" FontSize="21"/><TextBlock Text="收入不自动增加预算；新月份沿用最近一个月的预算，剩余金额不自动累加。" Style="{StaticResource Label}" Margin="0,6,12,0"/></StackPanel></DockPanel></StackPanel></Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="管理大类" Style="{StaticResource SectionTitle}"/><TextBlock Text="重命名会同步更新历史账目。停用的大类仍保留历史记录，也可以重新启用。" Style="{StaticResource Label}" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="CategoryKind" AutomationProperties.Name="管理大类类型"/><ComboBox x:Name="ManageCategory" Grid.Column="1" Margin="10,0,0,0" AutomationProperties.Name="管理大类选择"/><Button x:Name="AddCategory" Grid.Column="2" Content="新增" Margin="10,0,0,0"/><Button x:Name="RenameCategory" Grid.Column="3" Content="改名" Margin="7,0,0,0"/><Button x:Name="ToggleCategory" Grid.Column="4" Content="停用 / 启用" Margin="7,0,0,0"/></Grid></StackPanel></Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource SectionTitle}"/><TextBlock Text="每次更改都会保留上一版账本。手动备份包含全部账目、预算和大类，可用于换电脑或恢复数据。" Style="{StaticResource Label}" Margin="0,0,0,14"/><WrapPanel><Button x:Name="ManualBackup" Content="备份全部数据" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button x:Name="RestoreBackup" Content="从备份恢复" Margin="0,0,8,8"/><Button x:Name="OpenBackupFolder" Content="查看自动备份" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="DataLocation" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/><Button x:Name="OpenDataFolder" Content="打开数据文件夹" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="统计口径" Style="{StaticResource SectionTitle}"/><TextBlock Text="预算剩余 = 本月预算 − 本月支出&#10;收支结余 = 本月收入 − 本月支出，不代表银行卡余额&#10;日均支出按从月初到今天的自然天数计算，未消费的日期也计入天数&#10;剩余每天可用按明天至月底计算；历史月份展示整月汇总&#10;当前月份对比上月相同日期范围；历史月份对比上月整月" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="25"/><TextBlock Text="个人本机账本 · 版本 1.2.0" Style="{StaticResource Label}" Margin="0,15,0,0"/></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" Grid.Row="2" Text="准备就绪" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,12,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
